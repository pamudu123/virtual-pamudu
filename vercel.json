{
  "services": {
    "web": {
      "root": "web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "AGENT_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "api",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
