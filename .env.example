# ---- api/ (Python deep agent) ----
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Default: google/gemini-3-flash-preview
AGENT_MODEL=
# Optional but recommended (higher GitHub rate limits)
GITHUB_TOKEN=
# Needed for the "send Pamudu a message" feature
BREVO_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_SENDER_EMAIL=
# Postgres connection string (pooled). Required in production so conversations
# and approval pauses survive across serverless instances. Leave empty locally.
DATABASE_URL=
# Comma-separated origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:3000

# ---- web/ (Next.js + CopilotKit) ----
# Where the Next.js server reaches the Python agent
AGENT_URL=http://localhost:8000/agent
